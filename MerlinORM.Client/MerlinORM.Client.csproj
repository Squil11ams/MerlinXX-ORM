<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>3.0.0</Version>
    <PackageVersion>3.0.0</PackageVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>MerlinORM Client</Title>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <Authors>Squi11iams</Authors>
    <PackageIcon>logo.png</PackageIcon>
    <PackageProjectUrl>https://github.com/Squil11ams/MerlinXX-ORM</PackageProjectUrl>
    <Description>Merlin is a lightweight .NET utility framework providing reusable infrastructure components for application development, including object mapping, type conversion, structured exception handling, resource-based messaging, and extensible data access support. Designed to simplify complex application logic while maintaining clear diagnostics and developer-friendly error reporting.</Description>
    <Copyright>2026</Copyright>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/Squil11ams/MerlinXX-ORM.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>dotnet;reflection;mapping;object-mapper;conversion;exceptions;utilities;framework;database;mysql;orm</PackageTags>
    <PackageReleaseNotes>## 3.0.0
### Added
- Compiler-generated mappings with automatic runtime fallback.
- Per-result-set ordinal mapping plans and compiled value converters.
- Strict, Projection, and Validated mapping modes.
- Required-property validation with MerlinRequired.
- Recursive nested generated mappings with configurable object creation.
- Constructor, init-only property, record, and partial access-shim support.
- Mapping lifecycle interception through before/after auto-population hooks.
- User Secrets, environment variable, and IConfiguration connection-string support.
- SourceLink metadata and deterministic portable symbols.
- MERLINSG001 fallback warnings and MERLINSG002 enforcement errors.

### Changed
- RelationalQueryEngine is now the shared provider-independent query engine.
- Generated Create contracts remove the parameterless-constructor requirement for generated models.
- The legacy SetDataObject(IDataReader, string) override path is obsolete.

### Breaking Changes
- Custom SetDataObject overrides should migrate to mapping lifecycle hooks or generated mapping contracts.
- Query mapping internals and model construction behavior have changed to support source generation and Native AOT.</PackageReleaseNotes>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IncludeSymbols>True</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\logo.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MerlinORM.Generators\MerlinORM.Generators.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="buildTransitive\MerlinORM.Client.props"
          Pack="true"
          PackagePath="buildTransitive\MerlinORM.Client.props" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\MerlinORM.Generators\bin\$(Configuration)\netstandard2.0\MerlinORM.Generators.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.9" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="ErrorCodes.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>ErrorCodes.resx</DependentUpon>
    </Compile>
    <Compile Update="ErrorModules.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>ErrorModules.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="ErrorCodes.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>ErrorCodes.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="ErrorModules.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>ErrorModules.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
