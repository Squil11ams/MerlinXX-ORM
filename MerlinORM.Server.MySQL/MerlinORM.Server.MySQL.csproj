<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>3.0.0</Version>
    <PackageVersion>3.0.0</PackageVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>MerlinORM MySQL</Title>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <Authors>Squi11iams</Authors>
    <PackageIcon>logo.png</PackageIcon>
    <PackageProjectUrl>https://github.com/Squil11ams/MerlinXX-ORM</PackageProjectUrl>
    <Description>Merlin is a lightweight .NET utility framework providing reusable infrastructure components for application development, including object mapping, type conversion, structured exception handling, resource-based messaging, and extensible data access support. Designed to simplify complex application logic while maintaining clear diagnostics and developer-friendly error reporting.</Description>
    <Copyright>2026</Copyright>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/Squil11ams/MerlinXX-ORM.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>dotnet;reflection;mapping;object-mapper;conversion;exceptions;utilities;framework;database;mysql;orm</PackageTags>
    <PackageReleaseNotes>## 3.0.0
### Added
- Mapping strictness and nested-object creation settings on MySQL query providers.
- SourceLink metadata and deterministic portable symbols.

### Changed
- Provider now delegates shared execution and mapping behavior to RelationalQueryEngine.
- Uses the generated and cached-ordinal mapping pipeline supplied by MerlinORM.Client 3.0.0.

### Breaking Changes
- Requires MerlinORM.Client 3.0.0 and its updated mapping contracts.</PackageReleaseNotes>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IncludeSymbols>True</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\logo.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MySqlConnector" Version="2.6.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MerlinORM.Client\MerlinORM.Client.csproj" />
  </ItemGroup>

</Project>
